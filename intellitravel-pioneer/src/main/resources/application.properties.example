# ===========================================
# IntelliTravel Pioneer - 配置文件模板
# 复制此文件为 application.properties 并填写实际值
# ===========================================

spring.application.name=intellitravel-pioneer

# JPA / Database
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# 数据库连接（请修改为实际值）
spring.datasource.url=jdbc:mysql://localhost:3306/intellitravel?serverTimezone=UTC&useUnicode=true&characterEncoding=utf-8&useSSL=false
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password

# AI trip planning service configuration
trip.ai.provider=llm

# SiliconFlow API configuration
trip.ai.llm.base-url=https://api.siliconflow.cn
trip.ai.llm.chat-path=/v1/chat/completions
trip.ai.llm.api-key=your_siliconflow_api_key
trip.ai.llm.model=Qwen/Qwen3-8B
trip.ai.llm.temperature=0.2

# Image Generation Configuration
trip.ai.image.model=Kwai-Kolors/Kolors
trip.ai.image.path=/v1/images/generations
trip.ai.image.size=1024x1024

# Amap MCP SSE configuration (used by Agent tool calls)
trip.ai.amap.mcp-url=https://mcp.amap.com/sse?key=your_amap_mcp_key

# Amap official API configuration (used by HttpMapApiClient)
amap.key=your_amap_api_key
amap.geocode-url=https://restapi.amap.com/v3/geocode/geo
amap.weather-url=https://restapi.amap.com/v3/weather/weatherInfo
amap.static-map-url=https://restapi.amap.com/v3/staticmap

# File upload configuration
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# 阿里云 OSS 配置（请修改为实际值）
aliyun.oss.endpoint=oss-cn-shanghai.aliyuncs.com
aliyun.oss.access-key-id=your_oss_access_key_id
aliyun.oss.access-key-secret=your_oss_access_key_secret
aliyun.oss.bucket-name=your_bucket_name
