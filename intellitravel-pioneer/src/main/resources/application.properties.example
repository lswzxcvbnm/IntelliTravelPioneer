# ===========================================
# IntelliTravel Pioneer - 配置文件模板
# 复制此文件为 application.properties 并填写实际值
# ===========================================

spring.application.name=intellitravel-pioneer

# JPA / Database
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect

# 数据库连接（请修改为实际值）
spring.datasource.url=jdbc:mysql://localhost:3306/intellitravel?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&useSSL=false
spring.datasource.username=your_db_username # ← 请填写数据库用户名
spring.datasource.password=your_db_password # ← 请填写数据库密码

# AI trip planning service configuration
trip.ai.provider=llm

# 一般情况下不填写，仅当切换到自定义AI服务时需要配置
trip.ai.base-url=

trip.ai.plan-path=/api/trips/plan
trip.ai.status-analysis-path=/api/trips/status/analyze
trip.ai.summary-path=/api/trips/summary

# LLM API configuration
trip.ai.llm.base-url=https://api.deepseek.com
trip.ai.llm.chat-path=/v1/chat/completions

trip.ai.llm.api-key=your_llm_api_key # ← 请填写LLM API密钥

trip.ai.llm.model=deepseek-v4-flash
trip.ai.llm.temperature=0.2

# Image Generation Configuration (SiliconFlow)
trip.ai.image.base-url=https://api.siliconflow.cn

trip.ai.image.api-key=your_siliconflow_api_key # ← 请填写SiliconFlow API密钥

trip.ai.image.model=Kwai-Kolors/Kolors
trip.ai.image.path=/v1/images/generations
trip.ai.image.size=1024x1024

# Amap MCP SSE configuration (used by Agent tool calls)
trip.ai.amap.mcp-url=https://mcp.amap.com/sse?key=your_amap_mcp_key # ← 请替换为您的高德地图MCP密钥

# Amap official API configuration (used by HttpMapApiClient)

amap.key=your_amap_api_key # ← 请填写高德地图API密钥

amap.geocode-url=https://restapi.amap.com/v3/geocode/geo
amap.weather-url=https://restapi.amap.com/v3/weather/weatherInfo
amap.static-map-url=https://restapi.amap.com/v3/staticmap

# File upload configuration
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# JWT configuration
jwt.secret=your_jwt_secret_key # ← 请填写JWT密钥

# 阿里云 OSS 配置（请修改为实际值）
aliyun.oss.endpoint=oss-cn-shanghai.aliyuncs.com
aliyun.oss.access-key-id=your_oss_access_key_id # ← 请填写阿里云OSS AccessKey ID
aliyun.oss.access-key-secret=your_oss_access_key_secret # ← 请填写阿里云OSS AccessKey Secret
aliyun.oss.bucket-name=your_bucket_name # ← 请填写阿里云OSS存储桶名称
