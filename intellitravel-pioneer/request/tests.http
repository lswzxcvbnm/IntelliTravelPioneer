### 6. 生成行程战报海报 
# 注意：前端可以将刚刚拿到的轨迹图URL、计算出的步数和耗时在这里传给后端渲染生成海报。
# 将URL中的id替换成你测试真实的id
POST http://localhost:8080/api/trips/af5940706acc45c688cefee7c4ee336f/report
Content-Type: application/json
token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhdWQiOiIxIiwiZXhwIjoxNzcyNzY4MzgxfQ.bRcFCwakdMTNnisN2AsDYCiKxyEVLkAb6C4rYkiE11c

{
  "trajectoryUrl": "https://restapi.amap.com/v3/staticmap?key=bc02d1f93e142eb512f2a9d058d32560&size=750*400&scale=2&traffic=0&paths=8,0x3366FF,1,,:121.4737,31.2304;121.5073,31.2987;121.43233597344802,31.020729302720287&markers=mid,0x00AA00,S:121.4737,31.2304%7Cmid,0xDD0000,E:121.43233597344802,31.020729302720287",
  "steps": 8500,
  "powerCost": 450,
  "durationMin": 120,
  "theme": "nature"
}

### 7. AI 自动生成行程计划 (Generate Itinerary)
# @name generateItinerary
POST http://localhost:8080/api/itinerary/generate
Content-Type: application/json
token: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhdWQiOiIxIiwiZXhwIjoxNzcyNzY4MzgxfQ.bRcFCwakdMTNnisN2AsDYCiKxyEVLkAb6C4rYkiE11c

{
  "departure": "Shanghai",
  "destination": "Paris, France",
  "days": 3,
  "interests": ["Museums", "Food", "History"],
  "budgetLevel": "Medium",
  "additionalNotes": "Prefer walking tours."
}

